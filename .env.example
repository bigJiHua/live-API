# ============================================
# 系统初始化配置
# ============================================
# 是否跳过初始化（设为 true 时完全跳过 init，不检查数据库、不跑迁移）
# 用途：怀疑 init 有问题时可临时跳过，安全重启后再排查
INIT_SKIP=false

# 是否启用深度初始化（首次启动后自动设为 false）
# true = 全量备份 + Schema 同步 + 管理员创建 + .env 清理
# false = 仅跑增量迁移（日常模式）
# 首次部署时设为 true，初始化完成后自动改为 false
INIT_ENABLE=false

# 初始管理员账户配置（仅在 INIT_ENABLE=true 时生效）
# 如果不设置，将使用默认值: admin / Admin123.
# 注意 前端密码校验要包含 大小写字母 数字 和 特殊符号组成
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=your_secure_password
INIT_ADMIN_EMAIL=admin@example.com

# ============================================
# 服务器配置
# ============================================
NODE_ENV=development
PORT=3001

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=live

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session 配置
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# 密码加密配置
# BCRYPT_SALT_ROUNDS: bcrypt 盐轮数 (用于密码加密强度)
# 说明:
#   - 数字越大,加密越安全,但计算时间越长
#   - 推荐值: 开发环境 10, 生产环境 12-15
#   - 例如: 10 表示进行 2^10 = 1024 轮哈希运算
#   - 安全性: 每增加 1,计算时间翻倍,破解难度指数级增加
#   - 性能影响: 10 约需 100-200ms, 15 约需 3-5 秒
BCRYPT_SALT_ROUNDS=10

# 邮件配置
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# 前端 URL
FRONTEND_URL=http://localhost:3000

# 应用名称
APP_NAME=生活管理系统

# ---- 反向代理层数（P1-18，2026-10-08 新增）----
# API 前面有几层反代（nginx / CDN / 网关…）。用于决定 req.ip 取 X-Forwarded-For 的哪一段。
#
# ⚠️ 不要再无脑信任全部 XFF（历史写法 trust proxy=true）：
#    XFF 是客户端可构造的请求头，全信等于让任何人伪造 req.ip，
#    会连带绕过按 IP 的风控/限流，并把审计日志里的 IP 写错。
#
#   0  = 完全不信任 XFF（**直连部署时用这个**，此时 req.ip = 真实来源）
#   1  = 前面有 1 层 nginx（最常见）。API 直接由 nginx 反代时用这个
#   N  = 前面有 N 层
# 留空 = 等同0
# 填错的后果：req.ip 变成反代自身地址（表现为「所有用户都来自 127.0.0.1」），
#            只影响 IP 记录与按 IP 的限流统计，不影响功能。
TRUST_PROXY_HOPS=1

# 高德地图 Web 服务 API Key（用于 IP 定位与逆地理编码，在开放平台申请「Web服务」类型）
AMAP_KEY=your_amap_web_service_key

# ipinfo.io API Token（可选，用于 IP 定位国际回退，不填使用免费额度）
IPINFO_TOKEN=your_ipinfo_token

# ============================================
# 安全与风控（以下均有安全默认值，不写 = 用默认值）
# ============================================
# ⚠ 密钥相关（生产环境缺配/占位值/长度<32 会**拒绝启动**，见 src/common/utils/secretGuard.js）
# 生成方式：openssl rand -hex 32
# SHARE_TOKEN_SECRET 不写时回退 JWT_SECRET
# SHARE_TOKEN_SECRET=
# 字段级加密密钥（P1-9：device_crypto 握手行的 aes_key 落库加密）。
# 不写时从 SHARE_TOKEN_SECRET（回退 JWT_SECRET）派生，可零配置运行；
# 但建议独立配置 —— 换它即可使库中所有密文字段一次性失效重握手。
# FIELD_ENCRYPT_KEY=
# RSA 密钥对持久化文件（安全键盘字符级加密）。
# 默认 api/data/rsa-keys.json；多实例部署请指向共享路径，否则各实例密钥不同会随机登录失败。
# RSA_KEY_FILE=

# APP 签名自检白名单（P1-28）。取值：APK 签名证书的 SHA-256（64 位 hex），
# 生成：keytool -list -printcert -jarfile app-release.apk | grep SHA-256
# 多个用逗号分隔（换签共存）。**不配置 = 守卫不启用**（开源用户零影响）。
# 配置后：APP 请求带的 x-app-sign-sha256 必须匹配，重打包假 APP 被 403；
# APP_SIGN_ENFORCE=strict 时连浏览器请求也要求带头（仅纯 APP 部署用）。
# APP_SIGN_SHA256=
# APP_SIGN_ENFORCE=loose
# 会话最长天数，超期强制重新登录
# TOKEN_MAX_SESSION_DAYS=90

# 额外允许的跨域来源，逗号分隔。生产环境下内网/localhost 源不生效，需要时在此显式声明
# CORS_EXTRA_ORIGINS=

# ------------------------------------------------------------------
# 请求防重放（x-client-nonce）
# ------------------------------------------------------------------
# 设为 true 时**强制要求**请求携带 x-client-nonce，缺失直接 400。
# 开启前置条件：web / webview-APP / APP 三端均已携带该头（2026-09-21 已全部同步完成）。
# 未开启时策略为「携带才校验唯一性」，未携带的请求不受影响。
# REQUIRE_CLIENT_NONCE=false

# nonce 校验模式：enforce=拦截(默认) / observe=只告警不拦截 / off=完全关闭
# PIN_NONCE_MODE=enforce

# ------------------------------------------------------------------
# PIN 风控（阈值默认值与历史实现一致，改这里可现场调整而无需发版）
# ------------------------------------------------------------------
# 模式：enforce=严格拦截(默认) / observe=只告警不拦截 / off=完全关闭
# 误弹频繁时可临时切 observe 观测，或直接放宽下面的阈值
# PIN_RISK_MODE=enforce
# 全局频率：窗口内请求数上限 / 窗口秒数
# PIN_RISK_FREQ_LIMIT=60
# PIN_RISK_FREQ_WINDOW=60
# 敏感操作（POST/PUT/PATCH/DELETE）：窗口内次数上限 / 窗口秒数
# PIN_RISK_SENSITIVE_LIMIT=10
# PIN_RISK_SENSITIVE_WINDOW=60
# PIN 验证成功后的放行窗口（秒）
# PIN_PASS_WINDOW=30
