# ============================================
# API_Go 环境变量模板（与 api/.env 运行配置同步）
# 用法：复制为 .env 后按需修改：copy .env.example .env
# 说明：Go 端键名与 Node 端保持一致，便于两端对照运行；
#       仅 PORT 不同（Go 固定 7777，见 main.go SYNC-A18）。
# ============================================

# ============================================
# 系统初始化配置
# ============================================
# 是否跳过初始化（设为 true 时完全跳过 init，不检查数据库、不跑迁移）
INIT_SKIP=false

# 是否启用深度初始化（首次启动后自动设为 false）
# true = 全量备份 + Schema 同步 + 管理员创建 + .env 清理
INIT_ENABLE=false

# 初始化失败是否拒绝启动。false = 强制放行（仅排障用）
# INIT_STRICT=true

# 初始管理员账户配置（仅在 INIT_ENABLE=true 时生效）
# 不设置时默认 admin / admin123（Go 端 init 默认值）
# 注意：前端密码校验需包含大小写字母、数字和特殊符号
INIT_ADMIN_USER=admin
INIT_ADMIN_PASS=your_secure_password
INIT_ADMIN_EMAIL=admin@example.com

# ============================================
# 服务器配置
# ============================================
NODE_ENV=development

# Go 端独立端口：7777（Node 端为 666，两端可并行运行对照）
PORT=7777

# 数据库配置（与 Node 端共用同一库即可）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=live_dev

# 反向代理层数（P1-18）
# 0=直连不信任 XFF（直连部署用这个）；1=前面 1 层 nginx（最常见）；N=N 层；留空=0
# 填错后果：req.ip 变成反代自身地址（表现为「所有用户都来自 127.0.0.1」）
TRUST_PROXY_HOPS=1

# 密码加密强度
# bcrypt 盐轮数：越大越安全但越慢，开发 10 / 生产 12-15
BCRYPT_SALT_ROUNDS=10

# JWT 配置
# ⚠ 生产环境密钥长度需 ≥32 位且不能是占位值，否则拒绝启动（见 main.go secretGuard）
# 生成：openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 邮件配置
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# 前端 URL（分享链接拼接与 CORS 放行来源）
FRONTEND_URL=http://localhost:3000

# 应用名称（邮件标题等使用）
APP_NAME=生活管理系统

# ============================================
# 安全与风控（以下均有安全默认值，不写 = 用默认值；改完需重启生效）
# ============================================
# ---- 密钥 / 会话 ----
# 分享 token 密钥。⚠ 一旦设置不建议再改：改掉会让所有已发出的分享链接立即失效
# 留空 = 回退 JWT_SECRET
# SHARE_TOKEN_SECRET=

# 字段级加密密钥（P1-9：device_crypto 握手行的 aes_key 落库加密）
# 留空 = 从 SHARE_TOKEN_SECRET（回退 JWT_SECRET）派生
# ⚠ 换它会使库中所有密文字段一次性失效重握手，按需启用
# FIELD_ENCRYPT_KEY=

# RSA 密钥对持久化文件（安全键盘字符级加密）。默认 rsa_key.pem（进程 CWD 相对）
# Go 端密钥落盘，重启不变键；多实例部署请指向共享路径，否则各实例密钥不同会随机登录失败
# RSA_KEY_FILE=rsa_key.pem

# 会话最长天数：Token 起算超过该天数强制重新登录
# TOKEN_MAX_SESSION_DAYS=90

# 额外允许的跨域来源（逗号分隔）。生产环境默认只放行 FRONTEND_URL，需要时在此显式声明
# CORS_EXTRA_ORIGINS=

# ---- APP 签名自检白名单（P1-28）----
# 取值：APK 签名证书的 SHA-256（64 位 hex，无冒号），多个用逗号分隔（换签共存）
# 不配置 = 守卫不启用；配置后 APP 请求带的 x-app-sign-sha256 必须匹配，重打包假 APP 被 403
# APP_SIGN_ENFORCE：loose=只校验带头的请求（默认，兼容浏览器）/ strict=连浏览器也要求带头
# APP_SIGN_SHA256=
# APP_SIGN_ENFORCE=loose

# ---- 客户端请求防重放（x-client-nonce）----
# true = 强制要求所有 /api/v1 请求携带 x-client-nonce，缺失直接 400「非法请求！」
# false/留空 = 宽松策略：携带才校验唯一性，不带的请求放行
# 前置条件：web / webview-APP / APP 三端源码均已携带该头且已重新构建/安装
REQUIRE_CLIENT_NONCE=false

# nonce 校验模式：enforce=拦截(默认) / observe=只告警不拦截 / off=完全关闭
# PIN_NONCE_MODE=enforce

# ---- PIN 风控（PIN 码二次验证的频率限制）----
# 模式：enforce=严格拦截(默认) / observe=只告警不拦截 / off=完全关闭
# PIN_RISK_MODE=enforce

# 全局频率：窗口内请求数上限 / 窗口秒数（统计所有方法，含 GET）
# PIN_RISK_FREQ_LIMIT=60
# PIN_RISK_FREQ_WINDOW=60

# 敏感操作（POST/PUT/PATCH/DELETE）：窗口内次数上限 / 窗口秒数
# PIN_RISK_SENSITIVE_LIMIT=10
# PIN_RISK_SENSITIVE_WINDOW=60

# PIN 验证成功后的放行窗口（秒）：该时段内并发请求不再重复验证
# PIN_PASS_WINDOW=30

# ============================================
# 第三方服务
# ============================================
# 高德地图 Web 服务 API Key（IP 定位与逆地理编码，需申请「Web服务」类型）
# AMAP_KEY=

# ipinfo.io API Token（可选，用于 IP 定位国际回退，不填用免费额度）
# IPINFO_TOKEN=

# ============================================
# 分期定时任务（recurring cron）
# ============================================
# 已过「计划入账日 + 宽限天数」仍未入账 → 作废
# INSTALLMENT_GRACE_DAYS=30

# 扫描间隔（毫秒），默认 6 小时
# INSTALLMENT_SCAN_INTERVAL_MS=21600000

# 首次扫描延迟（毫秒），默认 30 秒（等服务就绪）
# INSTALLMENT_SCAN_FIRST_DELAY=30000

# 定时任务开关：false = 完全关闭
# INSTALLMENT_SCAN_ENABLED=true

# true = 只报告不入账（首次上线建议先跑一遍看清单）
# INSTALLMENT_SCAN_DRY_RUN=false

# ============================================
# 说明
# ============================================
# 1) Node 端专用键 SESSION_SECRET / JWT_REFRESH_EXPIRES_IN 在 Go 端无对应实现，故不列入本模板。
# 2) 生产环境 NODE_ENV=production 时，JWT_SECRET / SHARE_TOKEN_SECRET 弱密钥将直接拒绝启动。
# 3) 本文件为模板，真实 .env 含明文凭据，已被 .gitignore 排除，切勿提交。
